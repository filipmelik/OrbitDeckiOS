<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<!-- A satellite pass runs 8-15 minutes, and the operator routinely locks the screen
             or switches apps partway through it. The app must keep recording and playing
             audio for the whole pass:
               - Pass recording captures the radio's received audio to an AAC file
                 (Recording/PassRecorder.swift).
               - SSTV and FT4 decode the received audio continuously; FT4 also synthesizes
                 and plays transmit audio out to the radio (Audio/USBAudioSource.swift).
               - Remote voice streams the radio's received audio to the device speaker
                 (Audio/AudioHub.swift).
             Interrupting any of these loses the pass - the satellite is gone and won't be
             back for ~90 minutes. -->
		<string>audio</string>
	</array>
</dict>
</plist>
